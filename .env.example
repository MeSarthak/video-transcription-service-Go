# Server Configuration
PORT=8080
ENV=development
LOG_LEVEL=debug
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/transcription_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_MAX_IDLE_TIME=15m

# Authentication (JWT)
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=video-transcription-bucket
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/transcription-queue
